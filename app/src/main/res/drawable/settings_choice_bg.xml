<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Thin theme edge stroke (#FF4ADE80) and subtle green tint -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#284ADE80" />
            <corners android:radius="14dp" />
            <stroke android:width="2.5dp" android:color="#FF4ADE80" />
        </shape>
    </item>
    <!-- Selected / Active state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#204ADE80" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF4ADE80" />
        </shape>
    </item>
    <!-- Normal / Unfocused state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A222C" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3394A3B8" />
        </shape>
    </item>
</selector>
