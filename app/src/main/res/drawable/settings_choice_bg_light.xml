<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Thin theme edge stroke (#FF10B981) and subtle green tint -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2010B981" />
            <corners android:radius="14dp" />
            <stroke android:width="2.5dp" android:color="#FF10B981" />
        </shape>
    </item>
    <!-- Selected / Active state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1810B981" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF10B981" />
        </shape>
    </item>
    <!-- Normal / Unfocused state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFE2E8F0" />
        </shape>
    </item>
</selector>
