<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F00F172A" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#330284C7" />
            <stroke android:width="1.5dp" android:color="#FF0284C7" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1A000000" android:endColor="#0A000000" />
            <stroke android:width="1dp" android:color="#26000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
