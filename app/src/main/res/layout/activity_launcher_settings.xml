<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0F141A"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Title & Subtitle Header -->
    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launcher_settings"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:id="@+id/settingsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select a category to customize options"
        android:textColor="#FF94A3B8"
        android:textSize="15sp" />

    <!-- Main Category Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Footer: credit on the left, donation pill on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settingsFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/made_in_india"
            android:textColor="#FF94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/chaiButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chai_pill_bg"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_chai"
            android:drawableTint="#FF4ADE80"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingBottom="10dp"
            android:paddingEnd="22dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:text="@string/buy_chai"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_medium" />
    </LinearLayout>

</LinearLayout>
