<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chai_title"
        android:textColor="#FF4ADE80"
        android:textSize="22sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/chai_subtitle"
        android:textColor="#FF94A3B8"
        android:textSize="14sp" />

    <!-- White card so the code keeps its quiet zone on the dark dialog. -->
    <ImageView
        android:id="@+id/chaiQr"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/chai_qr_bg"
        android:contentDescription="@string/chai_title"
        android:padding="6dp"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/chai_upi_id"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/chai_thanks"
        android:textColor="#FF94A3B8"
        android:textSize="13sp" />

</LinearLayout>
