<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperCard"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_margin="8dp"
    android:background="@drawable/wallpaper_card_selector"
    android:focusable="true"
    android:clickable="true">

    <!-- Wallpaper Preview Image -->
    <ImageView
        android:id="@+id/wallpaperPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Gradient overlay at bottom for text legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:background="@drawable/wallpaper_card_gradient" />

    <!-- Wallpaper Title / Label -->
    <TextView
        android:id="@+id/wallpaperName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@string/font_medium" />

    <!-- Active Selection Badge -->
    <TextView
        android:id="@+id/selectedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/active_badge_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Active"
        android:textColor="#FF0B131E"
        android:textSize="11sp"
        android:fontFamily="@string/font_medium"
        android:visibility="gone" />

</FrameLayout>
