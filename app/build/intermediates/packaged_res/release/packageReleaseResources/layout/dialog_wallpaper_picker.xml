<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF141A22"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wallpaper_label"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select a wallpaper preview card to apply to your home screen"
        android:textColor="#FF94A3B8"
        android:textSize="14sp" />

    <!-- Grid Container for Wallpaper Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallpaperGrid"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
