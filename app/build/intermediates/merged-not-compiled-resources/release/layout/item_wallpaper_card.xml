<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperCard"
    android:layout_width="220dp"
    android:layout_height="135dp"
    android:layout_margin="10dp"
    android:background="@drawable/settings_choice_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/wallpaperPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Gradient overlay at bottom for text legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="@drawable/wallpaper_card_gradient" />

    <TextView
        android:id="@+id/wallpaperName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@string/font_medium" />

    <!-- Active Selection Badge -->
    <TextView
        android:id="@+id/selectedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#DD4ADE80"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Active"
        android:textColor="#FF000000"
        android:textSize="11sp"
        android:fontFamily="@string/font_medium"
        android:visibility="gone" />

</FrameLayout>
